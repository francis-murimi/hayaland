{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                deal_reference,\n                deal_title,\n                deal_description,\n                deal_status,\n                domain_category_id,\n                initiator_party_id,\n                is_public,\n                created_at\n            FROM deals\n            WHERE (\n                $1 = ''\n                OR to_tsvector('english', COALESCE(deal_title, '') || ' ' || COALESCE(deal_description, ''))\n                    @@ plainto_tsquery('english', $1)\n            )\n            AND is_public = true\n            ORDER BY\n                ts_rank(\n                    to_tsvector('english', COALESCE(deal_title, '') || ' ' || COALESCE(deal_description, '')),\n                    plainto_tsquery('english', $1)\n                ) DESC,\n                created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
