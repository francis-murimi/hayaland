{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                display_name,\n                party_type,\n                verification_status,\n                trust_score,\n                primary_domain_id,\n                is_active,\n                created_at\n            FROM parties\n            WHERE (\n                $1 = ''\n                OR to_tsvector('english', COALESCE(display_name, '') || ' ' || COALESCE(email, ''))\n                    @@ plainto_tsquery('english', $1)\n            )\n            AND is_active = true\n            ORDER BY\n                ts_rank(\n                    to_tsvector('english', COALESCE(display_name, '') || ' ' || COALESCE(email, '')),\n                    plainto_tsquery('english', $1)\n                ) DESC,\n                trust_score DESC,\n                created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
