  "query": "\n            SELECT\n                id,\n                admin_user_id,\n                action_type,\n                target_type,\n                target_id,\n                before_snapshot,\n                after_snapshot,\n                reason,\n                ip_address,\n                created_at\n            FROM admin_actions\n            WHERE target_type = $1 AND target_id = $2\n            ORDER BY created_at DESC\n            LIMIT $3 OFFSET $4\n            ",
